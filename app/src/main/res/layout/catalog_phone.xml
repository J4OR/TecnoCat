<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity5">

    <!-- Top Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/catalog_title"
            android:textColor="@color/text_black"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Search Box -->
    <EditText
        android:id="@+id/et_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawablePadding="12dp"
        android:hint="@string/hint_search_product"
        android:inputType="text"
        android:paddingHorizontal="16dp"
        android:textColor="@color/text_black"
        android:textColorHint="@color/text_grey"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/cl_top_bar"
        android:importantForAutofill="no" />

    <!-- Filter Buttons (Chips) -->
    <LinearLayout
        android:id="@+id/ll_filters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        tools:ignore="ButtonStyle"
        app:layout_constraintTop_toBottomOf="@id/et_search">

        <Button
            android:id="@+id/btn_filter_all"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_add_button"
            android:gravity="center"
            android:paddingHorizontal="4dp"
            android:paddingVertical="8dp"
            android:text="@string/filter_all"
            android:textAllCaps="false"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/btn_filter_phones"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:outlineAmbientShadowColor="@color/text_grey"
            android:outlineSpotShadowColor="@color/text_grey"
            android:background="@drawable/bg_button_secondary"
            android:gravity="center"
            android:paddingHorizontal="4dp"
            android:paddingVertical="8dp"
            android:text="@string/filter_celulares"
            android:textAllCaps="false"
            android:textColor="@color/text_black"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/btn_filter_pcs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:outlineAmbientShadowColor="@color/text_grey"
            android:outlineSpotShadowColor="@color/text_grey"
            android:background="@drawable/bg_button_secondary"
            android:gravity="center"
            android:paddingHorizontal="4dp"
            android:paddingVertical="8dp"
            android:text="@string/filter_computadores"
            android:textAllCaps="false"
            android:textColor="@color/text_black"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toTopOf="@id/custom_bottom_nav"
        app:layout_constraintTop_toBottomOf="@id/ll_filters">

        <GridLayout
            android:id="@+id/gl_products_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:padding="8dp"
            android:useDefaultMargins="true" />
    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <include
        android:id="@+id/custom_bottom_nav"
        layout="@layout/layout_custom_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="136dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Overlay for smooth theme transition animation -->
    <View
        android:id="@+id/v_theme_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="100dp"
        android:visibility="gone"
        tools:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>
