<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity7">

    <!-- Top Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_top_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_computadoras"
            android:textColor="@color/text_black"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/custom_bottom_nav"
        app:layout_constraintTop_toBottomOf="@id/cl_top_bar">

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:padding="12dp"
            android:useDefaultMargins="true">

            <!-- Item 1: MacBook -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:background="@drawable/bg_category_card"
                android:padding="8dp"
                android:layout_margin="4dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cv_img1"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/prod_macbook"
                        android:src="@drawable/gato__1_" />

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="end"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_fav_circle"
                        android:padding="8dp"
                        android:contentDescription="@string/nav_favorites"
                        android:src="@android:drawable/btn_star_big_off"
                        app:tint="@color/text_grey" />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/tv_name1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/prod_macbook"
                    android:textColor="@color/text_black"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/cv_img1"
                    tools:layout_editor_absoluteX="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/price_macbook"
                    android:textColor="@color/brand_blue"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/tv_name1"
                    tools:layout_editor_absoluteX="8dp" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Item 2: Lenovo -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:background="@drawable/bg_category_card"
                android:padding="8dp"
                android:layout_margin="4dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cv_img2"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/prod_lenovo"
                        android:src="@drawable/gato__1_" />

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="end"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_fav_circle"
                        android:padding="8dp"
                        android:contentDescription="@string/nav_favorites"
                        android:src="@android:drawable/btn_star_big_off"
                        app:tint="@color/text_grey" />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/tv_name2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/prod_lenovo"
                    android:textColor="@color/text_black"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/cv_img2"
                    tools:layout_editor_absoluteX="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/price_lenovo"
                    android:textColor="@color/brand_blue"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/tv_name2"
                    tools:layout_editor_absoluteX="8dp" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Item 3: HP -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:background="@drawable/bg_category_card"
                android:padding="8dp"
                android:layout_margin="4dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cv_img3"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/prod_hp"
                        android:src="@drawable/gato__1_" />

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="end"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_fav_circle"
                        android:padding="8dp"
                        android:contentDescription="@string/nav_favorites"
                        android:src="@android:drawable/btn_star_big_off"
                        app:tint="@color/text_grey" />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/tv_name3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/prod_hp"
                    android:textColor="@color/text_black"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/cv_img3"
                    tools:layout_editor_absoluteX="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/price_hp"
                    android:textColor="@color/brand_blue"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/tv_name3"
                    tools:layout_editor_absoluteX="8dp" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Item 4: ASUS -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:background="@drawable/bg_category_card"
                android:padding="8dp"
                android:layout_margin="4dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cv_img4"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/prod_asus"
                        android:src="@drawable/gato__1_" />

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="end"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_fav_circle"
                        android:padding="8dp"
                        android:contentDescription="@string/nav_favorites"
                        android:src="@android:drawable/btn_star_big_off"
                        app:tint="@color/text_grey" />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/tv_name4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/prod_asus"
                    android:textColor="@color/text_black"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/cv_img4"
                    tools:layout_editor_absoluteX="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/price_asus"
                    android:textColor="@color/brand_blue"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/tv_name4"
                    tools:layout_editor_absoluteX="8dp" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </GridLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <include
        android:id="@+id/custom_bottom_nav"
        layout="@layout/layout_custom_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Overlay for smooth theme transition animation -->
    <View
        android:id="@+id/v_theme_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="100dp"
        android:visibility="gone"
        tools:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>
