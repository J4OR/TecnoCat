<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity3">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.05" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.95" />

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:fontFamily="sans-serif-black"
        android:text="@string/register_title"
        android:textColor="@color/text_black"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="16dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/guideline_end"
        app:layout_constraintStart_toStartOf="@id/guideline_start"
        app:layout_constraintTop_toBottomOf="@id/tv_title">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Nombre Completo -->
            <TextView
                android:id="@+id/tv_name_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_name"
                android:textColor="@color/text_black"
                android:textSize="14sp"
                android:textStyle="bold"
                android:labelFor="@id/etNombreCompleto" />

            <EditText
                android:id="@+id/etNombreCompleto"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:autofillHints="name"
                android:background="@drawable/bg_input"
                android:hint="@string/hint_name"
                android:inputType="textPersonName"
                android:paddingHorizontal="16dp"
                android:textColor="@color/text_black"
                android:textColorHint="@color/text_grey"
                tools:ignore="LabelFor,VisualLintTextFieldSize,TextContrastCheck" />

            <!-- Correo Electronico -->
            <TextView
                android:id="@+id/tv_email_reg_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/label_email_reg"
                android:textColor="@color/text_black"
                android:textSize="14sp"
                android:textStyle="bold"
                android:labelFor="@id/etCorreo" />

            <EditText
                android:id="@+id/etCorreo"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:autofillHints="emailAddress"
                android:background="@drawable/bg_input"
                android:hint="@string/hint_email_reg"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="16dp"
                android:textColor="@color/text_black"
                android:textColorHint="@color/text_grey"
                tools:ignore="LabelFor,VisualLintTextFieldSize,TextContrastCheck" />

            <!-- Contraseña -->
            <TextView
                android:id="@+id/tv_password_reg_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/label_password"
                android:textColor="@color/text_black"
                android:textSize="14sp"
                android:textStyle="bold"
                android:labelFor="@id/etContrasena" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp">

                <EditText
                    android:id="@+id/etContrasena"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:autofillHints="password"
                    android:background="@drawable/bg_input"
                    android:hint="@string/hint_password"
                    android:inputType="textPassword"
                    android:paddingHorizontal="16dp"
                    android:paddingEnd="64dp"
                    android:textColor="@color/text_black"
                    android:textColorHint="@color/text_grey"
                    tools:ignore="LabelFor,VisualLintTextFieldSize,TextContrastCheck" />

                <ImageButton
                    android:id="@+id/btn_toggle_register_password"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/bg_password_toggle"
                    android:contentDescription="@string/password_show"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_eye_closed"
                    app:tint="@color/white" />
            </FrameLayout>

            <!-- Confirmar contraseña -->
            <TextView
                android:id="@+id/tv_confirm_password_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/label_confirm_password"
                android:textColor="@color/text_black"
                android:textSize="14sp"
                android:textStyle="bold"
                android:labelFor="@id/etConfirmarContrasena" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp">

                <EditText
                    android:id="@+id/etConfirmarContrasena"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:autofillHints="password"
                    android:background="@drawable/bg_input"
                    android:inputType="textPassword"
                    android:paddingHorizontal="16dp"
                    android:paddingEnd="64dp"
                    android:textColor="@color/text_black"
                    android:textColorHint="@color/text_grey"
                    tools:ignore="LabelFor,VisualLintTextFieldSize,TextContrastCheck,DuplicateSpeakableTextCheck" />

                <ImageButton
                    android:id="@+id/btn_toggle_confirm_password"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/bg_password_toggle"
                    android:contentDescription="@string/password_show"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_eye_closed"
                    app:tint="@color/white" />
            </FrameLayout>

            <Button
                android:id="@+id/btnGuardar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_button"
                android:text="@string/btn_save"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btn_cancel"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp"
                android:outlineAmbientShadowColor="@color/text_grey"
                android:outlineSpotShadowColor="@color/text_grey"
                android:background="@drawable/bg_button_secondary"
                android:text="@string/btn_cancel"
                android:textAllCaps="false"
                android:textColor="@color/text_black"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
