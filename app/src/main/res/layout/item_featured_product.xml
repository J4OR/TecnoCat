<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="164dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:background="@drawable/bg_category_card"
    android:clickable="true"
    android:focusable="true"

    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="10dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="116dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/iv_featured_product"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/featured_product_image_description"
            android:scaleType="centerCrop"
            android:src="@drawable/gato__1_" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tv_featured_product_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/text_black"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_featured_product_price"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/brand_blue"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
